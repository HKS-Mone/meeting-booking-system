# ──────────────────────────────────────────────────────────────────────
# .dockerignore — Files excluded from the Docker build context.
# Keeping this tight dramatically speeds up `docker build`.
# ──────────────────────────────────────────────────────────────────────

# Local dev dependencies (installed fresh inside the image)
node_modules
npm-debug.log*

# Next.js build output (rebuilt inside the image)
.next
out

# Git / VCS
.git
.gitignore
.github

# Environment files — NEVER bake secrets into the image
.env
.env.*
!.env.example

# Editor & OS files
.DS_Store
*.pem
.vscode
.idea

# TypeScript build info
*.tsbuildinfo

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# README / docs (not needed at runtime)
README.md
AGENTS.md
CLAUDE.md
